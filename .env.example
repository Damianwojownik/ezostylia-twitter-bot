# Twitter API v2 credentials (Free tier)
# Get these from https://developer.twitter.com/en/portal/projects-and-apps
TWITTER_APP_KEY=your_api_key_here
TWITTER_APP_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_token_secret_here

# Optional: customize schedule (default: 9:00 AM daily)
# CRON_SCHEDULE=0 9 * * *
# TIMEZONE=Europe/Warsaw
